---
import { participationByName, slugByName, type Person } from '../lib/members';

interface Props {
  person: Person;
  /** Shown when the person has neither dept nor title. */
  fallbackDept?: string;
}
const { person, fallbackDept } = Astro.props;
const slug = slugByName[person.name];
const dept = person.dept ?? person.title ?? fallbackDept;
const count = participationByName[person.name]?.length ?? 0;
---
<li class="person" id={slug}>
  <button
    type="button"
    class="person-btn"
    data-name={person.name}
    data-dept={dept ?? ''}
    data-url={person.url ?? ''}
    data-slug={slug}
  >
    <span class="person-name">{person.name}</span>
    {dept && <span class="person-dept">{dept}</span>}
    {count > 0 && (
      <span class="person-count num" title={`${count} 次参赛记录`}>{count}</span>
    )}
  </button>
  {person.url && (
    <a class="person-link" href={person.url} target="_blank" rel="noopener" aria-label={`${person.name} 的个人主页`}>↗</a>
  )}
</li>

<style>
  .person {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .person-btn {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.625rem 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .person-name {
    font-weight: 500;
  }
  .person-dept {
    font-size: var(--text-xs);
    color: var(--fg-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .person-count {
    font-size: var(--text-xs);
    color: var(--fg-3);
  }
  .person-btn:hover .person-name {
    color: var(--accent);
  }
  .person-link {
    padding: 0.25rem 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-3);
    text-decoration: none;
  }
  .person-link:hover {
    color: var(--accent);
  }
  .person:target {
    box-shadow: inset 0 -2px var(--accent);
  }
</style>
