---
import { participationByName, slugByName, displayName, classYearIn, type Person } from '../lib/members';
import Icon from './Icon.astro';

interface Props {
  person: Person;
  /** Shown when the person has neither dept nor title. */
  fallbackDept?: string;
}
const { person, fallbackDept } = Astro.props;
const slug = slugByName[person.name];
const dept = person.dept ?? person.title ?? fallbackDept;
const count = participationByName[person.name]?.length ?? 0;
const label = displayName(person.name);
// The rows sit under a class heading, so the year is only worth repeating in the
// dialog, where there is no such heading to tell two same-named people apart.
const year = classYearIn(person.name);
const dialogDept = year ? (dept ? `${dept}, class of ${year}` : `Class of ${year}`) : dept;
---
<li class="person" id={slug}>
  <button
    type="button"
    class="person-btn"
    data-name={person.name}
    data-dept={dialogDept ?? ''}
    data-display={label}
    data-url={person.url ?? ''}
    data-slug={slug}
  >
    <span class="person-name">{label}</span>
    {dept && <span class="person-dept">{dept}</span>}
    {count > 0 && (
      <span class="person-count num" title={`${count} competition records`}>{count}</span>
    )}
  </button>
  {person.url && (
    <a class="person-link" href={person.url} target="_blank" rel="noopener" aria-label={`${person.name}: personal homepage`}><Icon name="arrow-up-right" size={16} /></a>
  )}
</li>

<style>
  /* The trailing column is always there, with or without a homepage link, so the
     buttons end at the same place and the counts form a column. */
  .person {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.75rem;
    align-items: center;
    gap: 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .person-btn {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.625rem 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .person-name {
    font-weight: 500;
  }
  .person-dept {
    font-size: var(--text-xs);
    color: var(--fg-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Column three whether or not the row has a department, so the counts line up. */
  .person-count {
    grid-column: 3;
    justify-self: end;
    font-size: var(--text-xs);
    color: var(--fg-3);
  }
  .person-btn:hover .person-name {
    color: var(--accent-text);
  }
  .person-link {
    display: inline-flex;
    padding: 0.25rem 0.375rem;
    color: var(--fg-3);
    text-decoration: none;
  }
  .person-link:hover {
    color: var(--accent-text);
  }
  .person:target {
    box-shadow: inset 0 -2px var(--accent);
  }
</style>
