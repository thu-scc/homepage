---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  activePage?: string;
  variant?: 'solid' | 'overlay';
}
const { activePage = 'home', variant = 'solid' } = Astro.props;

const navLinks = [
  { href: '/competition', page: 'competition', label: 'Competitions' },
  { href: '/members', page: 'members', label: 'Members' },
  { href: '/publications', page: 'publications', label: 'Publications' },
  { href: '/collaboration', page: 'collaboration', label: 'Collaboration' },
  { href: '/honors', page: 'honors', label: 'Honors' },
  { href: '/join', page: 'join', label: 'Join' },
];
---
<header class:list={['site-header', `is-${variant}`]} data-site-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="THUSCC home" aria-current={activePage === 'home' ? 'page' : undefined}>
      <Logo class="brand-mark" strokeWidth={3} />
      <span class="brand-name">THUSCC</span>
      <span class="brand-sub">Tsinghua Student Cluster Competition Team</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <ul>
        {navLinks.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} aria-current={activePage === l.page ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <Icon name="list" size={24} class="icon-open" />
      <Icon name="x" size={24} class="icon-close" />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line-2);
  }
  .site-header.is-overlay {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom: 0;
  }
  /* Where the browser supports scroll-driven animation, the overlay header
     stays fixed and becomes solid over the first 320px of scrolling. */
  @supports (animation-timeline: scroll()) {
    .site-header.is-overlay {
      position: fixed;
      border-bottom: 1px solid transparent;
      animation: header-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 320px;
    }
    @keyframes header-solid {
      from {
        background: transparent;
        border-bottom-color: transparent;
      }
      to {
        background: var(--bg);
        border-bottom-color: var(--line-2);
      }
    }
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--fg);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand:hover {
    color: var(--fg);
  }
  .brand-mark {
    width: 16px;
    height: 20px;
    align-self: center;
    color: var(--gold);
  }
  .brand-name {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--fg-3);
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(1rem, 1.8vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: block;
    padding-block: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--fg-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a:hover {
    color: var(--gold-2);
  }
  .site-nav a[aria-current="page"] {
    color: var(--gold);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.6em;
    text-decoration-color: var(--gold);
  }
  .nav-toggle {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .nav-toggle:hover {
    border-color: var(--line);
  }
  .nav-toggle .icon-close,
  .nav-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }
  .nav-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  @media (max-width: 1279px) {
    .brand-sub {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .nav-toggle {
      display: grid;
    }
    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .site-header[data-open="true"] .site-nav {
      display: block;
    }
    .site-header[data-open="true"] .site-nav li {
      animation: rise 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 40ms);
    }
    .site-header.is-overlay[data-open="true"] {
      background: var(--bg);
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav li + li {
      border-top: 1px solid var(--line-2);
    }
    .site-nav a {
      padding-block: 0.875rem;
      font-family: var(--font-serif);
      font-optical-sizing: auto;
      font-size: var(--text-xl);
      letter-spacing: 0;
    }
    .site-nav a[aria-current="page"] {
      text-decoration: none;
    }
  }
</style>
