---
/** The team's "Diablo" mark, drawn flat in currentColor. */
interface Props {
  class?: string;
  strokeWidth?: number;
  title?: string;
  [key: `data-${string}`]: string | undefined;
}
// `rest` carries the parent's scoped-style attribute so `class` passthrough works.
const { class: className, strokeWidth = 2.5, title, ...rest } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 100 120"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linejoin="miter"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <g fill="currentColor" stroke="none">
    <polygon points="50,0 25,20 50,10" opacity="0.9" />
    <polygon points="50,0 75,20 50,10" opacity="0.9" />
    <polygon points="50,10 22,50 50,50" opacity="0.5" />
    <polygon points="50,10 78,50 50,50" opacity="0.5" />
    <polygon points="22,50 50,50 50,85" opacity="0.25" />
    <polygon points="78,50 50,50 50,85" opacity="0.25" />
    <polygon points="15,50 5,25 25,20" opacity="0.65" />
    <polygon points="85,50 95,25 75,20" opacity="0.65" />
  </g>
  <polygon points="50,0 15,50 50,95 85,50" />
  <polygon points="50,10 22,50 50,85 78,50" />
  <line x1="15" y1="50" x2="85" y2="50" />
  <line x1="50" y1="10" x2="50" y2="95" />
  <polygon points="15,50 5,25 25,20" />
  <polygon points="85,50 95,25 75,20" />
  <line x1="25" y1="20" x2="50" y2="0" />
  <line x1="75" y1="20" x2="50" y2="0" />
  <line x1="35" y1="95" x2="50" y2="115" />
  <line x1="65" y1="95" x2="50" y2="115" />
</svg>
