---
import DiabloLogo from './DiabloLogo.astro';

interface Props {
  activePage?: string;
}
const { activePage = 'home' } = Astro.props;

const links = [
  { href: '/', page: 'home', label: '首页' },
  { href: '/collaboration', page: 'collaboration', label: '交叉合作' },
  { href: '/competition', page: 'competition', label: '竞赛情况' },
  { href: '/publications', page: 'publications', label: '学术发表' },
  { href: '/members', page: 'members', label: '团队成员' },
  { href: '/honors', page: 'honors', label: '荣誉徽章' },
  { href: '/join', page: 'join', label: '加入我们' },
];
---
<nav class="nav">
  <a href="/" class="nav-logo">
    <DiabloLogo class="nav-logo-icon" size="nav" />
    <span>THUSCC</span>
  </a>
  <ul class="nav-links" id="navLinks">
    {links.map(l => (
      <li><a href={l.href} class={activePage === l.page ? 'active' : ''}>{l.label}</a></li>
    ))}
  </ul>
  <button class="theme-btn" id="themeBtn" aria-label="切换主题">
    <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></svg>
    <span class="label" id="themeLabel">Dark</span>
  </button>
  <button class="nav-toggle" id="navToggle" type="button" aria-label="打开导航菜单" aria-expanded="false" aria-controls="navLinks">
    <span></span><span></span><span></span>
  </button>
</nav>

<style>
.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; padding: 0 var(--page-gutter); background: var(--nav-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(var(--fg-rgb), 0.06); transition: background 0.6s; }
.nav-logo { font-family: var(--serif-zh); font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; transition: color 0.6s; display: flex; align-items: center; gap: 10px; }
.nav-logo-icon { width: 26px; height: 30px; flex-shrink: 0; }
.nav-links { display: flex; gap: clamp(10px, 1.6vw, 26px); list-style: none; align-items: center; margin-left: auto; }
.nav-links a { font-size: 0.82rem; color: rgba(var(--fg-rgb), 0.65); text-decoration: none; transition: color 0.2s; letter-spacing: 0.01em; }
.nav-links a:hover, .nav-links a.active { color: var(--fg); }
.nav-toggle { display: none; cursor: pointer; padding: 8px; margin-left: 8px; color: var(--fg); background: transparent; border: 0; border-radius: 8px; }
.nav-toggle span { display: block; width: 20px; height: 1.5px; background: var(--fg); margin: 5px 0; transition: 0.3s; }
.theme-btn { background: none; border: 1px solid rgba(var(--fg-rgb), 0.15); border-radius: 8px; padding: 6px 8px; cursor: pointer; display: flex; align-items: center; gap: 4px; color: var(--fg); transition: border-color 0.2s, color 0.6s; margin-left: clamp(8px, 1.5vw, 20px); }
.theme-btn:hover { border-color: rgba(var(--fg-rgb), 0.35); }
.theme-btn svg { width: 16px; height: 16px; }
.theme-btn .label { font-family: var(--mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; }

@media (max-width: 1023px) {
  .nav-links { display: none; }
  .nav-toggle { display: block; }
  .nav-links.open { display: flex; flex-direction: column; align-items: stretch; position: absolute; top: var(--nav-h); left: 0; right: 0; max-height: calc(100svh - var(--nav-h)); overflow-y: auto; background: var(--nav-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); padding: 18px var(--page-gutter) 22px; gap: 4px; border-bottom: 1px solid rgba(var(--fg-rgb), 0.06); }
  .nav-links.open a { display: block; padding: 10px 0; font-size: 0.95rem; }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
}

@media (max-width: 767px) {
  .nav-logo { font-size: 1rem; gap: 8px; }
  .nav-logo-icon { width: 23px; height: 27px; }
  .theme-btn .label { display: none; }
  .theme-btn { padding: 6px; }
}

@media (min-width: 1440px) {
  .nav { padding-inline: max(var(--page-gutter), calc((100vw - var(--content-max)) / 2)); }
}
</style>
