---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import publications from '../data/publications.json';
---
<Base title="Publications" activePage="publications">
  <PageIntro
    title="Publications"
    lead="Papers and technical reports by the team from the SC Student Cluster Competition Reproducibility Challenge."
  />

  <ol class="pub-list">
    {publications.map((pub, i) => (
      <li class="pub">
        <span class="pub-index num" aria-hidden="true">[{i + 1}]</span>
        <div class="pub-body">
          <a class="pub-title" href={pub.url} target="_blank" rel="noopener">{pub.title}</a>
          <p class="pub-authors">{pub.authors.join(', ')}</p>
          <p class="pub-meta">
            <span class="mono">{pub.venueShort}</span>
            <span class="num">{pub.year}</span>
            {pub.competition && <span>{pub.competition} Reproducibility Challenge</span>}
            {pub.doi && (
              <a class="mono" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">doi:{pub.doi}</a>
            )}
          </p>
        </div>
      </li>
    ))}
  </ol>
</Base>

<style>
  .pub-list {
    list-style: none;
    padding: 0;
    max-width: 56rem;
  }
  .pub {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line-2);
  }
  .pub-index {
    font-size: var(--text-sm);
    color: var(--fg-3);
    padding-top: 0.35rem;
  }
  .pub-body {
    display: grid;
    gap: 0.5rem;
  }
  .pub-title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg);
    text-decoration-color: var(--line);
    text-wrap: pretty;
  }
  .pub-authors {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }
  .pub-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: var(--text-xs);
    color: var(--fg-3);
  }
  .pub-meta a {
    color: var(--fg-3);
  }
  .pub-meta a:hover {
    color: var(--accent-2);
  }
  @media (max-width: 480px) {
    .pub {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
