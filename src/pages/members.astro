---
import Base from '../layouts/Base.astro';
import members from '../data/members.json';
import competitions from '../data/competition-details.json';

// Build reverse index: person name → competition participation records
type ParticipationRecord = {
  id: string;
  name: string;
  role: string;
  awards: string[];
  year: number;
};

const participationIndex: Record<string, ParticipationRecord[]> = {};

const roleLabels: Record<string, string> = {
  coaches: '指导教师',
  players: '上场队员',
  support: '技术支持',
  training: '参加训练',
};

for (const [compId, comp] of Object.entries(competitions as Record<string, any>)) {
  if (!comp.team) continue;
  const year = parseInt(comp.date?.split('-')[0] || '0');
  for (const [role, people] of Object.entries(comp.team as Record<string, string[]>)) {
    if (!Array.isArray(people)) continue;
    for (const person of people) {
      if (!participationIndex[person]) participationIndex[person] = [];
      participationIndex[person].push({
        id: compId,
        name: comp.name,
        role: roleLabels[role] || role,
        awards: comp.awards || [],
        year,
      });
    }
  }
}

// Sort each person's records by year descending
for (const records of Object.values(participationIndex)) {
  records.sort((a, b) => b.year - a.year);
}

// Serialize for client-side use
const indexJSON = JSON.stringify(participationIndex);
---
<Base title="团队成员 · THUSCC" activePage="members">
  <section class="sec sec-top">
    <p class="sec-kicker">Team Members</p>
    <h2 class="sec-title">团队成员</h2>
    <p class="sec-lead">所有成员均来自清华大学（除非另行标注院系，默认为计算机科学与技术系）。点击姓名查看参赛记录。</p>

    <h3 class="group-heading">指导教师</h3>
    <div class="member-grid">
      {members.advisors.current.map(m => (
        <div class="member-card" data-name={m.name} data-url={m.url || ''} data-dept={m.title || ''}>
          <span class="member-name">{m.name}</span>
          {m.title && <span class="member-dept">{m.title}</span>}
          {m.url && (
            <a class="member-link" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name} 的主页`} onclick="event.stopPropagation()">
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
            </a>
          )}
        </div>
      ))}
    </div>
    <p class="former-note">前任指导教师：{members.advisors.former.join('、')}</p>

    <h3 class="group-heading">在队成员</h3>
    {members.active.map(group => (
      <div class="grade-section">
        <p class="grade-label">{group.grade}</p>
        <div class="member-grid">
          {group.members.map(m => (
            <div class="member-card" data-name={m.name} data-url={m.url || ''} data-dept={m.dept || ''}>
              <span class="member-name">{m.name}</span>
              {m.dept && <span class="member-dept">{m.dept}</span>}
              {m.url && (
                <a class="member-link" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name} 的主页`} onclick="event.stopPropagation()">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}

    <h3 class="group-heading">毕业成员</h3>
    {members.alumni.map(group => (
      <div class="grade-section">
        <p class="grade-label">{group.grade}</p>
        <div class="member-grid">
          {group.members.map(m => (
            <div class="member-card" data-name={m.name} data-url={m.url || ''} data-dept={m.dept || ''}>
              <span class="member-name">{m.name}</span>
              {m.dept && <span class="member-dept">{m.dept}</span>}
              {m.url && (
                <a class="member-link" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name} 的主页`} onclick="event.stopPropagation()">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Profile Modal -->
  <div class="modal-overlay" id="profileModal">
    <div class="modal-content">
      <button class="modal-close" id="modalClose" aria-label="关闭">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>
      <div class="modal-header">
        <h3 class="modal-name" id="modalName"></h3>
        <p class="modal-dept" id="modalDept"></p>
        <a class="modal-url" id="modalUrl" target="_blank" rel="noopener"></a>
      </div>
      <div class="modal-body" id="modalBody"></div>
    </div>
  </div>
</Base>

<script define:vars={{ indexJSON }}>
  const participationIndex = JSON.parse(indexJSON);

  function openProfile(card) {
    const name = card.dataset.name;
    const dept = card.dataset.dept;
    const url = card.dataset.url;
    const records = participationIndex[name] || [];

    document.getElementById('modalName').textContent = name;
    const deptEl = document.getElementById('modalDept');
    deptEl.textContent = dept || '';
    deptEl.style.display = dept ? 'block' : 'none';

    const urlEl = document.getElementById('modalUrl');
    if (url) {
      urlEl.href = url;
      urlEl.textContent = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
      urlEl.style.display = 'inline-flex';
    } else {
      urlEl.style.display = 'none';
    }

    const body = document.getElementById('modalBody');
    if (records.length === 0) {
      body.innerHTML = '<p class="modal-empty">暂无参赛记录</p>';
    } else {
      // Group by role
      const grouped = {};
      for (const r of records) {
        if (!grouped[r.role]) grouped[r.role] = [];
        grouped[r.role].push(r);
      }
      let html = '';
      for (const [role, items] of Object.entries(grouped)) {
        html += `<div class="modal-role-group"><p class="modal-role-label">${role}</p>`;
        for (const item of items) {
          const awardsStr = item.awards.length ? `<span class="modal-awards">${item.awards.join(' · ')}</span>` : '';
          html += `<a class="modal-comp-row" href="/competition/${item.id}"><span class="modal-comp-name">${item.name}</span>${awardsStr}</a>`;
        }
        html += '</div>';
      }
      body.innerHTML = html;
    }

    document.getElementById('profileModal').classList.add('open');
  }

  // Attach click handlers
  document.querySelectorAll('.member-card').forEach(card => {
    card.addEventListener('click', () => openProfile(card));
  });

  // Close modal
  document.getElementById('modalClose').addEventListener('click', () => {
    document.getElementById('profileModal').classList.remove('open');
  });
  document.getElementById('profileModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      document.getElementById('profileModal').classList.remove('open');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.getElementById('profileModal').classList.remove('open');
  });
</script>

<style>
  .group-heading { font-family: var(--serif-zh); font-weight: 600; font-size: clamp(1.2rem, 2vw, 1.5rem); margin: 5vh 0 2vh; }
  .grade-section { margin-bottom: 3vh; }
  .grade-label { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.5; margin-bottom: 1.2vh; padding-top: 1.5vh; border-top: 1px solid rgba(var(--fg-rgb), 0.06); }
  .former-note { font-size: 0.85rem; opacity: 0.6; margin: 1.5vh 0 2vh; }
  .member-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .member-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 8px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; position: relative; transition: border-color 0.2s; cursor: pointer; }
  .member-card:hover { border-color: var(--accent-light); }
  .member-name { font-family: var(--serif-zh); font-weight: 500; font-size: 1rem; line-height: 1.3; }
  .member-dept { font-family: var(--mono); font-size: 0.72rem; opacity: 0.55; letter-spacing: 0.02em; }
  .member-link { position: absolute; top: 10px; right: 10px; color: var(--accent-light); opacity: 0.6; transition: opacity 0.2s; line-height: 0; }
  .member-link:hover { opacity: 1; }

  /* Modal */
  .modal-overlay { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.6); backdrop-filter: blur(6px); align-items: center; justify-content: center; padding: 20px; }
  .modal-overlay.open { display: flex; }
  .modal-content { background: var(--bg); border: 1px solid var(--card-border); border-radius: 14px; padding: 0; max-width: 420px; width: 100%; max-height: 80vh; overflow: hidden; position: relative; box-shadow: 0 20px 60px rgba(0,0,0,0.3); display: flex; flex-direction: column; }
  .modal-close { position: absolute; top: 14px; right: 14px; background: rgba(var(--fg-rgb), 0.06); border: none; color: var(--fg); opacity: 0.6; cursor: pointer; padding: 6px; border-radius: 6px; z-index: 1; transition: opacity 0.2s, background 0.2s; }
  .modal-close:hover { opacity: 1; background: rgba(var(--fg-rgb), 0.12); }
  .modal-header { padding: 28px 28px 20px; border-bottom: 1px solid rgba(var(--fg-rgb), 0.06); }
  .modal-name { font-family: var(--serif-zh); font-weight: 700; font-size: 1.5rem; margin-bottom: 6px; letter-spacing: -0.01em; }
  .modal-dept { font-family: var(--sans-zh); font-size: 0.82rem; opacity: 0.55; margin-bottom: 8px; }
  .modal-url { font-family: var(--mono); font-size: 0.72rem; color: rgba(var(--fg-rgb), 0.6); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: color 0.2s; }
  .modal-url:hover { color: var(--accent-light); }
  .modal-body { padding: 20px 28px 28px; overflow-y: auto; flex: 1; }
  .modal-empty { opacity: 0.4; font-size: 0.85rem; text-align: center; padding: 20px 0; }
  .modal-role-group { margin-bottom: 20px; }
  .modal-role-group:last-child { margin-bottom: 0; }
  .modal-role-label { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.45; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid rgba(var(--fg-rgb), 0.06); }
  .modal-comp-row { display: block; padding: 10px 12px; margin: 0 -12px 8px; border-radius: 8px; text-decoration: none; color: inherit; transition: background 0.15s; border: 1px solid rgba(var(--fg-rgb), 0.04); }
  .modal-comp-row:last-child { margin-bottom: 0; }
  .modal-comp-row:hover { background: rgba(var(--fg-rgb), 0.05); border-color: rgba(var(--fg-rgb), 0.08); }
  .modal-comp-name { display: block; font-size: 0.85rem; font-weight: 500; font-family: var(--sans-zh); color: var(--fg); margin-bottom: 2px; }
  .modal-awards { display: block; font-family: var(--mono); font-size: 0.67rem; color: var(--gold-color); letter-spacing: 0.02em; }

  @media (max-width: 480px) {
    .member-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
    .modal-content { max-width: 100%; border-radius: 12px; }
    .modal-header { padding: 22px 20px 16px; }
    .modal-body { padding: 16px 20px 22px; }
  }
</style>
