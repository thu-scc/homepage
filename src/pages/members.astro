---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import PersonItem from '../components/PersonItem.astro';
import { advisors, activeGroups, alumniGroups, participationByName, slugByName, memberCount } from '../lib/members';

const memberData = JSON.stringify({ participation: participationByName, slugs: slugByName }).replace(/</g, '\\u003c');
---
<Base title="团队成员" activePage="members">
  <PageIntro
    eyebrow="Members"
    title="团队成员"
    lead={`成员均来自清华大学，未标注院系者为计算机科学与技术系。点击姓名查看参赛记录，共 ${memberCount} 位历届队员。`}
  />

  <section class="section">
    <div class="section-head"><h2 class="section-title">指导教师</h2></div>
    <ul class="people">
      {advisors.current.map((p) => <PersonItem person={p} />)}
    </ul>
    <h3 class="subhead">前任指导教师</h3>
    <ul class="people">
      {advisors.former.map((name) => <PersonItem person={{ name }} fallbackDept="前任指导教师" />)}
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="section-title">在队成员</h2></div>
    {activeGroups.map((g) => (
      <div class="grade">
        <h3 class="grade-label">{g.grade}</h3>
        <ul class="people">
          {g.members.map((p) => <PersonItem person={p} />)}
        </ul>
      </div>
    ))}
  </section>

  <section class="section">
    <div class="section-head"><h2 class="section-title">毕业成员</h2></div>
    {alumniGroups.map((g) => (
      <div class="grade">
        <h3 class="grade-label">{g.grade}</h3>
        <ul class="people">
          {g.members.map((p) => <PersonItem person={p} />)}
        </ul>
      </div>
    ))}
  </section>

  <dialog id="member-dialog" class="member-dialog" aria-labelledby="member-dialog-name">
    <div class="dialog-inner">
      <form method="dialog" class="dialog-close-form">
        <button class="dialog-close" aria-label="关闭">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </form>
      <header class="dialog-head">
        <h2 id="member-dialog-name" class="dialog-name"></h2>
        <p class="dialog-dept" hidden></p>
        <a class="dialog-url mono" target="_blank" rel="noopener" hidden></a>
      </header>
      <div class="dialog-body"></div>
    </div>
  </dialog>

  <script type="application/json" id="member-data" set:html={memberData} />
  <script src="../scripts/member-dialog.ts"></script>
</Base>

<style>
  .people {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0 2rem;
  }
  .grade {
    display: grid;
    gap: 0.25rem;
  }
  .grade + .grade {
    margin-top: 0.75rem;
  }
  .grade-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--fg-3);
  }
</style>

<style is:global>
  /* Dialog rows are generated on the client, so these stay global. */
  .member-dialog {
    width: min(100% - 2rem, 460px);
    max-height: min(80vh, 680px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--fg);
    box-shadow: var(--shadow);
  }
  .member-dialog::backdrop {
    background: rgba(20, 18, 25, 0.45);
  }
  .dialog-inner {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    max-height: min(80vh, 680px);
    position: relative;
  }
  .dialog-close-form {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    margin: 0;
  }
  .dialog-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg-3);
    cursor: pointer;
  }
  .dialog-close:hover {
    background: var(--surface-2);
    color: var(--fg);
  }
  .dialog-close svg {
    width: 18px;
    height: 18px;
  }
  .dialog-head {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem 3rem 1rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .dialog-name {
    font-size: var(--text-xl);
  }
  .dialog-dept {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }
  .dialog-url {
    font-size: var(--text-xs);
    color: var(--fg-3);
    overflow-wrap: anywhere;
    justify-self: start;
  }
  .dialog-body {
    padding: 0.5rem 1.5rem 1.5rem;
    overflow-y: auto;
  }
  .dialog-group + .dialog-group {
    margin-top: 1.25rem;
  }
  .dialog-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding-block: 0.75rem 0.25rem;
  }
  .dialog-role .num {
    margin-left: 0.25rem;
  }
  .dialog-comp {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .dialog-comp-name {
    font-weight: 500;
  }
  .dialog-comp:hover .dialog-comp-name {
    color: var(--accent);
  }
  .dialog-comp-awards {
    font-size: var(--text-xs);
    color: var(--fg-3);
    text-align: right;
  }
  .dialog-empty {
    padding: 1.5rem 0;
    text-align: center;
    color: var(--fg-3);
    font-size: var(--text-sm);
  }
  @media (max-width: 480px) {
    .member-dialog {
      width: 100%;
      max-width: none;
      max-height: 85vh;
      margin: auto 0 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
  }
</style>
