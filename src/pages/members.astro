---
import Base from '../layouts/Base.astro';
import members from '../data/members.json';
---
<Base title="团队成员 · THUSCC" activePage="members">
  <section class="sec sec-top">
    <p class="sec-kicker">Team Members</p>
    <h2 class="sec-title">团队成员</h2>
    <p class="sec-lead">所有成员均来自清华大学（除非另行标注院系，默认为计算机科学与技术系）。</p>

    <h3 class="group-heading">指导教师</h3>
    <div class="member-grid">
      {members.advisors.current.map(m => (
        <div class="member-card">
          <span class="member-name">{m.name}</span>
          {m.title && <span class="member-dept">{m.title}</span>}
          {m.url && (
            <a class="member-link" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name} 的主页`}>
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
            </a>
          )}
        </div>
      ))}
    </div>
    <p class="former-note">前任指导教师：{members.advisors.former.join('、')}</p>

    <h3 class="group-heading">在队成员</h3>
    {members.active.map(group => (
      <div class="grade-section">
        <p class="grade-label">{group.grade}</p>
        <div class="member-grid">
          {group.members.map(m => (
            <div class="member-card">
              <span class="member-name">{m.name}</span>
              {m.dept && <span class="member-dept">{m.dept}</span>}
              {m.url && (
                <a class="member-link" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name} 的主页`}>
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}

    <h3 class="group-heading">毕业成员</h3>
    {members.alumni.map(group => (
      <div class="grade-section">
        <p class="grade-label">{group.grade}</p>
        <div class="member-grid">
          {group.members.map(m => (
            <div class="member-card">
              <span class="member-name">{m.name}</span>
              {m.dept && <span class="member-dept">{m.dept}</span>}
              {m.url && (
                <a class="member-link" href={m.url} target="_blank" rel="noopener" aria-label={`${m.name} 的主页`}>
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>

<style>
  .group-heading {
    font-family: var(--serif-zh);
    font-weight: 600;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin: 5vh 0 2vh;
  }
  .grade-section {
    margin-bottom: 3vh;
  }
  .grade-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 1.2vh;
    padding-top: 1.5vh;
    border-top: 1px solid rgba(var(--fg-rgb), 0.06);
  }
  .former-note {
    font-size: 0.85rem;
    opacity: 0.6;
    margin: 1.5vh 0 2vh;
  }
  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
  }
  .member-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    transition: border-color 0.2s;
  }
  .member-card:hover {
    border-color: var(--accent-light);
  }
  .member-name {
    font-family: var(--serif-zh);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.3;
  }
  .member-dept {
    font-family: var(--mono);
    font-size: 0.72rem;
    opacity: 0.55;
    letter-spacing: 0.02em;
  }
  .member-link {
    position: absolute;
    top: 10px;
    right: 10px;
    color: var(--accent-light);
    opacity: 0.6;
    transition: opacity 0.2s;
    line-height: 0;
  }
  .member-link:hover {
    opacity: 1;
  }
  @media (max-width: 480px) {
    .member-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    }
  }
</style>
