---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import PersonItem from '../components/PersonItem.astro';
import Icon from '../components/Icon.astro';
import { advisors, activeGroups, alumniGroups, participationByName, slugByName, memberCount } from '../lib/members';

const memberData = JSON.stringify({ participation: participationByName, slugs: slugByName }).replace(/</g, '\\u003c');
---
<Base title="Members" activePage="members">
  <PageIntro
    title="Members"
    lead={`${memberCount} members since the class of 2008, all from Tsinghua University. Those without a department listed are in Computer Science and Technology. Select a name for their competition record.`}
  />

  <section class="section">
    <div class="section-head"><h2 class="section-title">Faculty advisors</h2></div>
    <ul class="people">
      {advisors.current.map((p) => <PersonItem person={p} />)}
    </ul>
    <h3 class="subhead">Former advisors</h3>
    <ul class="people">
      {advisors.former.map((name) => <PersonItem person={{ name }} fallbackDept="Former advisor" />)}
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="section-title">Current members</h2></div>
    {activeGroups.map((g) => (
      <div class="grade">
        <h3 class="grade-label">{g.grade}</h3>
        <ul class="people">
          {g.members.map((p) => <PersonItem person={p} />)}
        </ul>
      </div>
    ))}
  </section>

  <section class="section">
    <div class="section-head"><h2 class="section-title">Alumni</h2></div>
    {alumniGroups.map((g) => (
      <div class="grade">
        <h3 class="grade-label">{g.grade}</h3>
        <ul class="people">
          {g.members.map((p) => <PersonItem person={p} />)}
        </ul>
      </div>
    ))}
  </section>

  <dialog id="member-dialog" class="member-dialog" aria-labelledby="member-dialog-name">
    <div class="dialog-inner">
      <form method="dialog" class="dialog-close-form">
        <button class="dialog-close" aria-label="Close">
          <Icon name="x" size={22} />
        </button>
      </form>
      <header class="dialog-head">
        <h2 id="member-dialog-name" class="dialog-name"></h2>
        <p class="dialog-dept" hidden></p>
        <a class="dialog-url mono" target="_blank" rel="noopener" hidden></a>
      </header>
      <div class="dialog-body"></div>
    </div>
  </dialog>

  <script type="application/json" id="member-data" set:html={memberData} />
  <script src="../scripts/member-dialog.ts"></script>
</Base>

<style>
  .people {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 0 2.5rem;
  }
  .grade {
    display: grid;
    gap: 0.375rem;
  }
  .grade + .grade {
    margin-top: 1rem;
  }
  .grade-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--gold);
  }
</style>

<style is:global>
  /* Dialog rows are generated on the client, so these stay global. */
  .member-dialog {
    width: min(100% - 2rem, 480px);
    max-height: min(80vh, 680px);
    padding: 0;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    box-shadow: var(--shadow);
  }
  .member-dialog::backdrop {
    background: rgba(30, 18, 38, 0.6);
  }
  .dialog-inner {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    max-height: min(80vh, 680px);
    position: relative;
  }
  .dialog-close-form {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    margin: 0;
  }
  .dialog-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-3);
    cursor: pointer;
  }
  .dialog-close:hover {
    border-color: var(--line);
    color: var(--fg);
  }
  .dialog-head {
    display: grid;
    gap: 0.25rem;
    padding: 1.75rem 3.5rem 1.25rem 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .dialog-name {
    font-size: var(--text-2xl);
    font-weight: 600;
  }
  .dialog-dept {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }
  .dialog-url {
    font-size: var(--text-xs);
    color: var(--fg-3);
    overflow-wrap: anywhere;
    justify-self: start;
    text-decoration-color: var(--line);
  }
  .dialog-body {
    padding: 0.5rem 1.75rem 1.75rem;
    overflow-y: auto;
  }
  .dialog-group + .dialog-group {
    margin-top: 1.25rem;
  }
  .dialog-role {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--gold);
    padding-block: 1rem 0.375rem;
  }
  .dialog-role .num {
    margin-left: 0.375rem;
    color: var(--fg-3);
  }
  .dialog-comp {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--line-2);
    color: inherit;
    text-decoration: none;
  }
  .dialog-comp-name {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: var(--text-lg);
  }
  .dialog-comp:hover .dialog-comp-name {
    color: var(--gold-2);
  }
  .dialog-comp-awards {
    font-size: var(--text-xs);
    color: var(--fg-3);
    text-align: right;
  }
  .dialog-empty {
    padding: 1.5rem 0;
    text-align: center;
    color: var(--fg-3);
    font-size: var(--text-sm);
  }
  @media (max-width: 480px) {
    .member-dialog {
      width: 100%;
      max-width: none;
      max-height: 85vh;
      margin: auto 0 0;
    }
  }
</style>
