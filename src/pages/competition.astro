---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ResultBadge from '../components/ResultBadge.astro';
import ChampionTimeline from '../components/ChampionTimeline.astro';
import {
  columns,
  grandSlamYears,
  records,
  entriesFor,
  championCount,
  yearsOfHistory,
  type ResultType,
} from '../lib/competitions';

const legend: { type: ResultType; label: string }[] = [
  { type: 'champion', label: 'Champion' },
  { type: 'runner-up', label: 'Runner-up' },
  { type: 'linpack', label: 'LINPACK' },
  { type: 'eprize', label: 'E-Prize' },
  { type: 'special', label: 'Special award' },
  { type: 'place', label: 'Other placing' },
];
---
<Base title="Competitions" activePage="competition">
  <PageIntro
    eyebrow="Competition record"
    title="Competitions"
    lead="ASC, ISC and SC are the three major student supercomputing competitions. Teams build their own clusters under a strict power cap and run benchmarks and real scientific applications against the clock. Tsinghua is the only team to have won all three."
  />

  <dl class="facts">
    <div class="fact"><dt>Championships</dt><dd>{championCount}</dd></div>
    <div class="fact"><dt>Years competing</dt><dd>{yearsOfHistory}</dd></div>
    <div class="fact"><dt>Grand slam years</dt><dd>{grandSlamYears.join(' · ')}</dd></div>
  </dl>

  <ChampionTimeline link={true} />

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Results by year</h2>
      <ul class="badge-list legend" aria-label="Legend">
        {legend.map((l) => (
          <li><span class={`badge badge-${l.type}`}>{l.label}</span></li>
        ))}
      </ul>
    </div>

    <div class="table-wrap results-table">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Year</th>
            {columns.map((c) => <th scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {records.map((row) => {
            const slam = grandSlamYears.includes(row.year);
            return (
              <tr id={`y${row.year}`} class:list={{ 'row-slam': slam }}>
                <th scope="row" class="year-cell">
                  <span class="num">{row.year}</span>
                  {slam && <span class="slam-tag">Grand slam</span>}
                </th>
                {columns.map((col) => {
                  const entries = entriesFor(row, col);
                  return (
                    <td>
                      {entries.length > 0 && (
                        <ul class="badge-list">
                          {entries.map((e) => (
                            <li><ResultBadge entry={e} /></li>
                          ))}
                        </ul>
                      )}
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <ol class="results-list">
      {records.map((row) => {
        const slam = grandSlamYears.includes(row.year);
        const filled = columns.filter((c) => entriesFor(row, c).length > 0);
        return (
          <li class:list={['year-block', { 'row-slam': slam }]}>
            <h3 class="year-heading">
              <span class="num">{row.year}</span>
              {slam && <span class="slam-tag">Grand slam</span>}
            </h3>
            {filled.length > 0 ? (
              <dl class="year-results">
                {filled.map((c) => (
                  <div class="year-result">
                    <dt class="mono">{c}</dt>
                    <dd>
                      <ul class="badge-list">
                        {entriesFor(row, c).map((e) => (
                          <li><ResultBadge entry={e} /></li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="section-note">No entries</p>
            )}
          </li>
        );
      })}
    </ol>
  </section>
</Base>

<style>
  .legend {
    gap: 0.375rem;
  }
  .year-cell {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--fg);
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
    width: 1%;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .row-slam .year-cell .num {
    color: var(--gold);
  }
  .slam-tag {
    display: inline-block;
    margin-left: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    vertical-align: 0.1em;
  }
  tr:target .year-cell .num {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.3em;
  }

  .results-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .year-block {
    display: grid;
    gap: 0.625rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line-2);
  }
  .year-heading {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .year-block.row-slam .year-heading .num {
    color: var(--gold);
  }
  .year-results {
    display: grid;
    gap: 0.5rem;
  }
  .year-result {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }
  .year-result dt {
    font-size: var(--text-xs);
    color: var(--fg-3);
    letter-spacing: 0.08em;
  }

  @media (max-width: 720px) {
    .results-table {
      display: none;
    }
  }
  @media (min-width: 721px) {
    .results-list {
      display: none;
    }
  }
</style>
