---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ResultBadge from '../components/ResultBadge.astro';
import {
  columns,
  grandSlamYears,
  records,
  entriesFor,
  championCount,
  yearsOfHistory,
  type ResultType,
} from '../lib/competitions';

const legend: { type: ResultType; label: string }[] = [
  { type: 'champion', label: '冠军' },
  { type: 'runner-up', label: '亚军' },
  { type: 'linpack', label: 'LINPACK' },
  { type: 'eprize', label: 'E-Prize' },
  { type: 'special', label: '特别奖' },
  { type: 'place', label: '其他名次' },
];
---
<Base title="竞赛情况" activePage="competition">
  <PageIntro
    eyebrow="Competition record"
    title="竞赛情况"
    lead="ASC、ISC、SC 是三大国际大学生超算竞赛：参赛队在严格的功耗限制下自行搭建集群，运行基准测试与真实的科学应用。清华是全球唯一在三项赛事中都夺得过冠军的队伍。"
  />

  <dl class="facts">
    <div class="fact"><dt>国际赛事冠军</dt><dd>{championCount}</dd></div>
    <div class="fact"><dt>年竞赛历程</dt><dd>{yearsOfHistory}</dd></div>
    <div class="fact"><dt>三大赛事大满贯</dt><dd>{grandSlamYears.join(' · ')}</dd></div>
  </dl>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">历年成绩</h2>
      <ul class="badge-list legend" aria-label="图例">
        {legend.map((l) => (
          <li><span class={`badge badge-${l.type}`}>{l.label}</span></li>
        ))}
      </ul>
    </div>

    <div class="table-wrap results-table">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">年份</th>
            {columns.map((c) => <th scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {records.map((row) => {
            const slam = grandSlamYears.includes(row.year);
            return (
              <tr class:list={{ 'row-slam': slam }}>
                <th scope="row" class="year-cell">
                  <span class="num">{row.year}</span>
                  {slam && <span class="slam-tag">大满贯</span>}
                </th>
                {columns.map((col) => {
                  const entries = entriesFor(row, col);
                  return (
                    <td>
                      {entries.length > 0 && (
                        <ul class="badge-list">
                          {entries.map((e) => (
                            <li><ResultBadge entry={e} /></li>
                          ))}
                        </ul>
                      )}
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <ol class="results-list">
      {records.map((row) => {
        const slam = grandSlamYears.includes(row.year);
        const filled = columns.filter((c) => entriesFor(row, c).length > 0);
        return (
          <li class:list={['year-block', { 'row-slam': slam }]}>
            <h3 class="year-heading">
              <span class="num">{row.year}</span>
              {slam && <span class="slam-tag">大满贯</span>}
            </h3>
            {filled.length > 0 ? (
              <dl class="year-results">
                {filled.map((c) => (
                  <div class="year-result">
                    <dt class="mono">{c}</dt>
                    <dd>
                      <ul class="badge-list">
                        {entriesFor(row, c).map((e) => (
                          <li><ResultBadge entry={e} /></li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="section-note">无参赛记录</p>
            )}
          </li>
        );
      })}
    </ol>
  </section>
</Base>

<style>
  .legend {
    gap: 0.375rem;
  }
  .year-cell {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
    width: 1%;
  }
  .row-slam th,
  .row-slam td {
    background: color-mix(in srgb, var(--gold-soft) 55%, transparent);
  }
  .slam-tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.375rem;
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.5;
    color: var(--gold);
    vertical-align: 0.1em;
  }

  .results-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .year-block {
    display: grid;
    gap: 0.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
  }
  .year-block.row-slam {
    padding-inline: 0.75rem;
    border-radius: var(--radius);
    border-bottom: 0;
  }
  .year-heading {
    font-size: var(--text-base);
  }
  .year-results {
    display: grid;
    gap: 0.5rem;
  }
  .year-result {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }
  .year-result dt {
    font-size: var(--text-xs);
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .results-table {
      display: none;
    }
  }
  @media (min-width: 721px) {
    .results-list {
      display: none;
    }
  }
</style>
