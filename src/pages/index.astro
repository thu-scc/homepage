---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ChampionTimeline from '../components/ChampionTimeline.astro';
import ResultBadge from '../components/ResultBadge.astro';
import { championCount, yearsOfHistory, grandSlamYears, recentResults, details, numberWords } from '../lib/competitions';

const photoModules = import.meta.glob<ImageMetadata>('/src/assets/competition/**/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photoFor = (publicPath: string) => photoModules[publicPath.replace(/^\/img\//, '/src/assets/')];

// The opener is the most recent championship that has a photograph.
const hero = recentResults(20).find((r) => r.entries.some((e) => e.type === 'champion') && details[r.id]?.photos?.length);
const heroDetail = hero ? details[hero.id] : undefined;
const heroImage = heroDetail?.photos?.[0] ? photoFor(heroDetail.photos[0]) : undefined;
const heroPlace = heroDetail?.location?.split(',').slice(-2).map((s) => s.trim()).join(', ');

// Three recent events with photographs, the opener excluded; the first is featured.
const stories = recentResults(20)
  .filter((r) => r.id !== hero?.id && details[r.id]?.photos?.length)
  .slice(0, 3)
  .map((r) => ({ ...r, detail: details[r.id], image: photoFor(details[r.id].photos![0]) }));
---
<Base activePage="home" header="overlay" bleed>
  <section class="photo-hero">
    {heroImage && (
      <Image
        src={heroImage}
        widths={[800, 1280, 1920, 2560]}
        sizes="100vw"
        format="webp"
        quality={72}
        alt={heroDetail ? `The team on stage at ${heroDetail.name}` : 'The team'}
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="container photo-hero-body">
      {heroDetail && (
        <p class="eyebrow rise">{heroDetail.name}{heroPlace ? `, ${heroPlace}` : ''}</p>
      )}
      <h1 class="photo-hero-title rise rise-2">
        <em>{numberWords(yearsOfHistory)}</em> years, <em>{numberWords(championCount)}</em> championships, <em>{numberWords(grandSlamYears.length)}</em> grand slams.
      </h1>
      <p class="lead hero-lead rise rise-3">
        The only student team to have won all three major supercomputing competitions: ASC, ISC and SC.
      </p>
      <div class="hero-actions rise rise-3">
        <a class="btn btn-gold" href="/competition">See the record</a>
        <a class="btn" href="/join">Join the team</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2 class="section-title">Championship years</h2>
    </div>
    <ChampionTimeline />
    <p class="timeline-caption">
      Gold marks a year with at least one championship. A ring marks a grand slam, when the team won ASC, ISC and SC in the same year.
    </p>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2 class="section-title">Recent competitions</h2>
    </div>
    <div class="photo-cards">
      {stories.map((s, i) => (
        <a class="photo-card" href={`/competition/${s.id}`}>
          <div class="frame">
            {s.image && (
              <Image
                src={s.image}
                widths={[480, 800, 1200, 1600]}
                sizes={i === 0 ? '(min-width: 1240px) 700px, (min-width: 720px) 60vw, 100vw' : '(min-width: 1240px) 440px, (min-width: 720px) 40vw, 100vw'}
                format="webp"
                quality={74}
                alt={`The team at ${s.name}`}
                loading="lazy"
              />
            )}
          </div>
          <div class="body">
            <ul class="badge-list">
              {s.entries.map((e) => (
                <li><ResultBadge entry={e} link={false} /></li>
              ))}
            </ul>
            <span class="title">{s.name}</span>
            {i === 0 && s.detail.highlights && <span class="desc">{s.detail.highlights}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container duo">
    <div class="duo-item">
      <h2 class="duo-title">Research collaboration</h2>
      <p class="duo-desc">
        We work with research groups on numerical simulation, large-scale data processing, AI inference and distributed
        systems, from the GRID gamma-ray satellites to genomics.
      </p>
      <a class="btn btn-gold" href="/collaboration">Work with us</a>
    </div>
    <div class="duo-item">
      <h2 class="duo-title">New members every autumn</h2>
      <p class="duo-desc">
        We recruit each autumn semester and train from scratch. Physics, mathematics and chemical engineering students
        have all competed for the team.
      </p>
      <a class="btn" href="/join">Join the team</a>
    </div>
  </section>
</Base>

<style>
  .hero-lead {
    max-width: 38rem;
  }
  .duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 3rem clamp(2rem, 5vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .duo-item {
    display: grid;
    gap: 1rem;
    justify-items: start;
    align-content: start;
  }
  .duo-title {
    font-size: var(--text-2xl);
    font-weight: 600;
  }
  .duo-desc {
    color: var(--fg-2);
    max-width: 40rem;
    text-wrap: pretty;
  }
</style>
