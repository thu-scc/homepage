---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { details, roleOrder, roleLabels, type CompetitionDetail } from '../../lib/competitions';
import { memberHref } from '../../lib/members';

export function getStaticPaths() {
  return Object.entries(details).map(([id, info]) => ({ params: { id }, props: { id, info } }));
}

const { info } = Astro.props as { id: string; info: CompetitionDetail };

// Photos are referenced in the JSON as /img/competition/<id>/NN.jpg and live in src/assets/competition.
const photoModules = import.meta.glob<ImageMetadata>('/src/assets/competition/**/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photos = (info.photos ?? []).map((src) => ({
  src,
  image: photoModules[src.replace(/^\/img\//, '/src/assets/')],
}));

const teamRoles = roleOrder.filter((r) => (info.team?.[r]?.length ?? 0) > 0);
const problems = info.problems ?? [];
const news = info.news ?? [];
const hasBody = teamRoles.length > 0 || problems.length > 0 || news.length > 0 || photos.length > 0;
const eyebrow = [info.date ?? info.sortDate, info.location].filter(Boolean).join(' · ');

function awardType(award: string): string {
  if (award.includes('冠军')) return 'champion';
  if (award.includes('亚军')) return 'runner-up';
  if (/linpack/i.test(award)) return 'linpack';
  if (/e-?prize/i.test(award)) return 'eprize';
  return 'place';
}
---
<Base title={info.name} activePage="competition">
  <a class="back-link" href="/competition"><span aria-hidden="true">←</span> 返回竞赛总览</a>

  <PageIntro eyebrow={eyebrow} title={info.name}>
    {info.awards.length > 0 && (
      <ul class="badge-list awards" aria-label="获奖">
        {info.awards.map((a) => (
          <li><span class={`badge badge-${awardType(a)} award`}>{a}</span></li>
        ))}
      </ul>
    )}
    {info.highlights && <p class="lead">{info.highlights}</p>}
  </PageIntro>

  {teamRoles.length > 0 && (
    <section class="section">
      <div class="section-head"><h2 class="section-title">团队成员</h2></div>
      <div class="team-grid">
        {teamRoles.map((role) => (
          <div class="team-role">
            <h3 class="eyebrow">{roleLabels[role]}</h3>
            <ul class="name-list">
              {info.team![role]!.map((name) => {
                const href = memberHref(name);
                return <li>{href ? <a href={href}>{name}</a> : name}</li>;
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {problems.length > 0 && (
    <section class="section">
      <div class="section-head"><h2 class="section-title">赛题</h2></div>
      <ul class="row-list">
        {problems.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  )}

  {news.length > 0 && (
    <section class="section">
      <div class="section-head"><h2 class="section-title">相关报道</h2></div>
      <ul class="row-list">
        {news.map((n) => (
          <li>
            <a href={n.url} target="_blank" rel="noopener">{n.title} <span class="ext" aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {photos.length > 0 && (
    <section class="section">
      <div class="section-head"><h2 class="section-title">照片</h2></div>
      <ul class="photo-grid">
        {photos.map((p, i) =>
          p.image ? (
            <li>
              <a href={p.image.src} target="_blank" rel="noopener">
                <Image
                  src={p.image}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 900px) 340px, (min-width: 600px) 50vw, 100vw"
                  format="webp"
                  quality={78}
                  alt={`${info.name} 团队照片 ${i + 1}`}
                  loading="lazy"
                />
              </a>
            </li>
          ) : (
            <li>
              <a href={p.src} target="_blank" rel="noopener">
                <img src={p.src} alt={`${info.name} 团队照片 ${i + 1}`} loading="lazy" />
              </a>
            </li>
          ),
        )}
      </ul>
    </section>
  )}

  {!hasBody && <p class="placeholder">详细信息待补充</p>}

  {info._notes && (
    <p class="notes"><span class="eyebrow">备注</span> {info._notes}</p>
  )}
</Base>

<style>
  .awards {
    gap: 0.5rem;
  }
  .award {
    font-size: var(--text-sm);
    padding: 0.2rem 0.7rem;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 1.5rem 2rem;
  }
  .team-role {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .name-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.125rem;
  }
  .name-list a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }
  .name-list a:hover {
    color: var(--accent);
  }
  .row-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }
  .row-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
  }
  .row-list a {
    color: var(--fg);
    text-decoration-color: var(--line-strong);
  }
  .row-list a:hover {
    color: var(--accent);
  }
  .ext {
    font-family: var(--font-mono);
    color: var(--fg-3);
  }
  .photo-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0.75rem;
  }
  .photo-grid a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .photo-grid img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .notes {
    font-size: var(--text-sm);
    color: var(--fg-2);
    max-width: var(--measure);
  }
  .notes .eyebrow {
    margin-right: 0.5rem;
  }
</style>
