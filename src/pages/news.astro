---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import NewsList from '../components/NewsList.astro';
import { newsByYear } from '../lib/news';

const years = newsByYear();
---
<Base
  title="News"
  description="Posts from the THUSCC WeChat account and press coverage of the Tsinghua University Student Cluster Competition Team."
  activePage="news"
>
  <PageIntro
    title="News"
    lead="Posts from the team's WeChat account, and coverage of the competitions in the press."
  />

  <div class="news-years">
    {years.map(({ year, items }) => (
      <section class="section" data-reveal>
        <div class="section-head">
          <h2 class="section-title num">{year}</h2>
        </div>
        <NewsList items={items} stagger />
      </section>
    ))}
  </div>
</Base>

<style>
  .news-years {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
  }
</style>
