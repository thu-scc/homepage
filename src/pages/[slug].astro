---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter(page => page.id !== 'members')
    .map(page => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { kicker, title, lead } = page.data;
const slug = page.id;
---
<Base title={`${title || slug} · THUSCC`} activePage={slug}>
  <section class="sec sec-top">
    {kicker && <p class="sec-kicker">{kicker}</p>}
    {title && <h2 class="sec-title">{title}</h2>}
    {lead && <p class="sec-lead">{lead}</p>}
    <div class="md-content">
      <Content />
    </div>
  </section>
</Base>
